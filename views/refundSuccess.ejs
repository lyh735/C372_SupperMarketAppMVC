<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Refund Successful</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Supermarket App</a>
      <div class="collapse navbar-collapse">
        <ul class="navbar-nav">
          <li class="nav-item"><a class="nav-link" href="/shopping">Shop</a></li>
          <li class="nav-item"><a class="nav-link" href="/cart">View Cart</a></li>
          <li class="nav-item"><a class="nav-link" href="/invoices">History</a></li>
          <li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <div class="alert alert-success">
      <h4 class="alert-heading mb-1">Refund processed successfully</h4>
      <p class="mb-0">Your refund has been completed. Please check your payment provider for final posting.</p>
    </div>

    <div class="card">
      <div class="card-body">
        <p><strong>Invoice ID:</strong> <%= invoiceId || '-' %></p>
        <p><strong>Refund Status:</strong> <%= refundStatus || 'refunded' %></p>
        <p><strong>Refund Date:</strong> <%= refundDate || '-' %></p>
        <p><strong>Refund Reason:</strong> <%= refundReason || '-' %></p>
        <p><strong>Refund Reference:</strong> <%= refundRef || '-' %></p>
        <p><strong>Refunded Amount:</strong> $<%= refundedAmount ? Number(refundedAmount).toFixed(2) : '0.00' %></p>
      </div>
    </div>

    <a href="/invoice/<%= invoiceId %>" class="btn btn-primary mt-3">Back to Invoice</a>
    <a href="/invoices" class="btn btn-secondary mt-3">View Purchase History</a>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
