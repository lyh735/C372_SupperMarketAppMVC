<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Payment Successful</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Supermarket App</a>
      <div class="collapse navbar-collapse">
        <ul class="navbar-nav">
          <li class="nav-item"><a class="nav-link" href="/shopping">Shop</a></li>
          <li class="nav-item"><a class="nav-link" href="/cart">View Cart</a></li>
          <li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <div class="alert alert-success">
      <h4 class="alert-heading mb-1">Payment successful</h4>
      <p class="mb-0">Your PayPal payment has been completed.</p>
    </div>

    <div class="card">
      <div class="card-body">
        <p><strong>Invoice ID:</strong> <%= invoiceId || '-' %></p>
      </div>
    </div>

    <div class="mt-3 d-flex gap-2">
      <a href="/shopping" class="btn btn-primary">Continue Shopping</a>
      <a href="/invoice/<%= invoiceId %>" class="btn btn-secondary">View Invoice</a>
    </div>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
